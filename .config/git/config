[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
[init]
	defaultBranch = main
[user]
	name = Espen Klungland
	email = espen.klungland@gmail.com
	signingkey = /home/espen/.ssh/id_ed25519.pub
[gpg]
	format = ssh
[commit]
	gpgsign = true
[pull]
	rebase = true
[core]
	editor = nvim
	autocrlf = input
	fileMode = false
	whitespace = -trailing-space
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	syntax-theme = Monokai Extended
	navigate = true
	dark = true
	line-numbers = true
	side-by-side = true
[merge]
	conflictStyle = zdiff3
