{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    "websearch": "allow",
    "webfetch": "allow",
    "lsp": "allow"
  },
  "enabled_providers": ["ollama", "openai", "opencode-go"],
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "gemma4:12b": {
          "name": "Gemma4 (12b)"
        }
      }
    },
  }
}
